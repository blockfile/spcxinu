# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Token ────────────────────────────────────────────────────────────────────
# SPACEINU's contract address on Robinhood Chain (launches on the Pons V2
# launchpad, paired with SPCX). Blank until launch ("CA coming soon") — every
# stat then answers null, which the site renders as "—" rather than a zero, and
# the rewards feed answers an empty page.
TOKEN_ADDRESS=
# Ticker without the "$" — the site shows it as $SPACEINU.
TOKEN_SYMBOL=SPACEINU
TOKEN_NAME=Space Inu
# Whole-token total supply and decimals. Used only to keep the pre-graduation
# market cap alive when Blockscout (the normal source) is unreachable. Pons V2
# launches mint 1,000,000,000 at 18 decimals; blank disables the fallback.
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_DECIMALS=18

# ── Upstreams (no API keys needed) ───────────────────────────────────────────
# Blockscout instance for Robinhood Chain — source of the holder count and of
# the rewards feed (token transfers out of the fee distributor).
EXPLORER_API=https://robinhoodchain.blockscout.com
# DexScreener's slug for the chain — source of the market cap.
DEXSCREENER_CHAIN_ID=robinhood

# ── Caching ──────────────────────────────────────────────────────────────────
# How long a fetched value is served before refreshing, in ms. Every visitor's
# browser polls /stats every 60s, so these are what keep the upstreams from
# seeing one request per visitor.
MARKET_TTL_MS=30000
HOLDERS_TTL_MS=120000

# ── Rewards: "Total $SPCX Rewarded" (Pons fee distributor) ───────────────────
# SPACEINU's creator tax accrues in SPCX and is pushed to holders by a per-token fee
# distributor. The cumulative "paid to holders" total comes from Pons's public
# API (the same source their token page shows).
PONS_API=https://www.ponsfamily.com
# SPCX (tokenized SpaceX stock, "Space Exploration Technologies Corp • Robinhood
# Token") — the curve's quote asset and the reward asset. Its DexScreener USD
# price converts the pre-graduation bonding-curve price to USD and the rewarded
# total to USD.
REWARD_TOKEN_ADDRESS=0x4a0e65a3eccec6dbe60ae065f2e7bb85fae35eea
# Decimals of the SPCX reward asset.
REWARD_DECIMALS=18
REWARDS_TTL_MS=60000

# ── Rewards feed (GET /rewards) ──────────────────────────────────────────────
# The feed lists SPCX transfers OUT of the fee distributor (each one is a payout
# to a holder wallet), read from Blockscout. The distributor address is resolved
# from the Pons API automatically; set it here only to pin it (or if Pons is
# down). Leave blank normally.
DISTRIBUTOR_ADDRESS=
# Per-page cache TTL for the feed, in ms.
FEED_TTL_MS=30000

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins that may call the API. Must
# include the scheme. Use "*" to allow any origin (not recommended).
# Non-browser calls (curl, uptime checks) always pass.
CORS_ORIGINS=https://spaceinu.meme,https://www.spaceinu.meme
