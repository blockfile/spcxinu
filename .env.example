# ── Server ───────────────────────────────────────────────────────────────────
# The PUBLIC API (server.js). nginx proxies api.spaceinu.art to this port.
PORT=3000

# The BOT's operator API (bot.js). Bound to 127.0.0.1 — never proxy this from
# nginx: POST /run pays real money out.
BOT_PORT=3100

# ── Token ────────────────────────────────────────────────────────────────────
# SPACEINU's contract address on Robinhood Chain (launches on the Pons V2
# launchpad, paired with SPCX). Blank until launch ("CA coming soon") — every
# stat then answers null, which the site renders as "—" rather than a zero, and
# the rewards feed answers an empty page.
TOKEN_ADDRESS=
# Ticker without the "$" — the site shows it as $SPACEINU.
TOKEN_SYMBOL=SPACEINU
TOKEN_NAME=Space Inu
# Whole-token total supply and decimals. Keeps the pre-graduation market cap
# alive when Blockscout (the normal source) is unreachable, and is what DRY_RUN
# uses in place of an on-chain decimals() call. Pons V2 launches mint
# 1,000,000,000 at 18 decimals; blank disables the market-cap fallback.
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_DECIMALS=18

# ── Upstreams (no API keys needed) ───────────────────────────────────────────
# Blockscout instance for Robinhood Chain — source of the holder count and of
# the holder snapshot the airdrop is computed from.
EXPLORER_API=https://robinhoodchain.blockscout.com
# DexScreener's slug for the chain — source of the market cap and SPCX/USD.
DEXSCREENER_CHAIN_ID=robinhood
# Pons. STILL REQUIRED even though this bot does its own distributing: the
# bonding-curve chart endpoint here is what prices SPACEINU before it graduates.
PONS_API=https://www.ponsfamily.com
# JSON-RPC for the bot's chain reads and writes.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# ── Reward asset ─────────────────────────────────────────────────────────────
# SPCX (tokenized SpaceX stock) — the launch's QUOTE asset and therefore the
# REWARD asset. One address, both roles: fees accrue in it because SPACEINU is
# priced in it, and it is what holders are paid. There is deliberately no second
# "quote token" key, so the two can never drift apart.
REWARD_TOKEN_ADDRESS=0x4a0e65a3eccec6dbe60ae065f2e7bb85fae35eea
REWARD_DECIMALS=18

# ── Bot: wallet ──────────────────────────────────────────────────────────────
# MUST be SPACEINU's creatorFeeRecipient — the only address allowed to sweep or
# claim. Read by bot.js ONLY; server.js never loads it. If this is wrong the bot
# runs without a single error and silently collects nothing, forever.
#
# Use a FRESH wallet, not your deployer wallet. They are separate fields on
# pons ("Creator wallet" on the create form), and leaving that field blank
# defaults it to your connected wallet — which would put your deployer key on
# this server.
#
# Whoever holds this key can call transferCreatorFeeRecipient and permanently
# redirect the fee stream: only the CURRENT recipient may reassign it, so the
# deployer cannot undo it. What sits in the wallet is not what is at stake.
#
# ALSO: leave Pons's "route creator fees to holders" toggle OFF. Switching it on
# reassigns creatorFeeRecipient to a fee-distributor contract, and this bot
# instantly has nothing to claim. The two mechanisms are mutually exclusive.
#
# Blank is fine while DRY_RUN=true — an ephemeral wallet stands in.
WALLET_PRIVATE_KEY=

# DRY_RUN=true simulates every on-chain call: no funds move, no RPC is needed,
# and a simulated fee vault stands in for the escrow. Set to false ONLY after a
# funded wallet is configured and `npm run check` looks right.
DRY_RUN=true

# ── Bot: trigger ─────────────────────────────────────────────────────────────
# accumulation -> claim once the accrued SPCX is worth CLAIM_EVERY_USD
# interval     -> claim whatever has accrued on every tick
#
# The gate is in USD, not tokens: SPCX is worth hundreds of dollars, so a token
# threshold is unusable. If the SPCX price is briefly unavailable the bot HOLDS
# rather than claiming blind — the fees keep accruing for the next tick.
TRIGGER_MODE=accumulation
CLAIM_EVERY_USD=100
# How often the gate is evaluated (not how often it fires).
POLL_SCHEDULE=*/5 * * * *
# DRY_RUN only: simulated SPCX accrued to the vault per tick.
DRY_RUN_FEE_PER_POLL=0.05

# ── Bot: split and eligibility ───────────────────────────────────────────────
# Each claim splits three ways. REWARD_PCT and BURN_PCT are set here; the dev
# cut is WHATEVER IS LEFT, so at the default 80/20 there is none at all and
# every SPCX collected goes back to holders or into the buyback.
#
#   REWARD_PCT  airdropped to SPACEINU holders, pro-rata
#   BURN_PCT    used to BUY SPACEINU, which is then burned (supply drops)
#   remainder   the dev cut (see DEV_PAYOUT_ADDRESS)
#
# The two together may not exceed 100; the bot refuses to start if they do.
REWARD_PCT=80
BURN_PCT=20

# Slippage tolerance for the buyback swap, percent. Only the buyback swaps —
# the reward leg pays out the SPCX it claimed, untouched.
SLIPPAGE_PCT=5

# Cold address that receives the dev cut at the end of every cycle.
#
# An ADDRESS, never a key — this wallet only receives, so its key can stay in a
# hardware wallet and never touch the server. That is the whole point: the bot
# wallet's key sits in this file on an internet-facing box, and without this the
# dev cut piles up there indefinitely. With it set, the server wallet only ever
# holds gas plus the cut of the cycle currently in flight.
#
# Blank leaves the dev cut in the bot wallet (you then sweep it by hand).
# A malformed address is refused at startup, not mid-cycle.
DEV_PAYOUT_ADDRESS=
# Minimum SPACEINU balance to qualify for the airdrop, in whole tokens.
MIN_HOLD=100000
# Per-wallet weight cap, % of supply (0 = pure pro-rata).
REWARD_CAP_PCT=0
# JSON array of address-groups treated as one wallet for the cap.
CLUSTERS=[]
# Extra excluded owners, comma-separated.
AIRDROP_EXCLUDE=
# Max transfers in flight at once; also recipients per disperse batch.
AIRDROP_BATCH_SIZE=30
# Fixed gas per airdrop transfer (skips a per-tx estimateGas round trip).
AIRDROP_GAS_LIMIT=120000
# ERC-20 batch-transfer contract. Blank -> one pipelined transfer per recipient,
# which is fine at a few hundred holders.
#
# It MUST expose exactly:
#   function disperseToken(address token, address[] recipients, uint256[] values)
# NOTE: pons-launcher/contracts/Disperse.sol is NOT this — that one is native
# ETH only and every batch would revert on an unknown selector.
#
# The wallet must also approve() SPCX to it first; the bot does not do that.
# Both mistakes fail AFTER the escrow has been claimed, so verify before setting.
DISPERSE_ADDRESS=

# Gas is NOT self-funding here: the dev cut is SPCX while gas is ETH, so the
# wallet cannot refill itself from what it collects. Below this ETH balance a
# cycle refuses to START, rather than claiming and then failing to pay anyone.
GAS_RESERVE_ETH=0.01

# ── pons v2 wiring (verified on chain; override only if pons redeploys) ──────
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
BUYBACK_VAULT=0x42df2a798f82289E177311362e8f5ccC45c1219c
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# ── Storage ──────────────────────────────────────────────────────────────────
# Both processes share this database: the bot writes payouts, the API reads them.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=spaceinu

# ── Caching ──────────────────────────────────────────────────────────────────
# How long a fetched value is served before refreshing, in ms. Every visitor's
# browser polls, so these are what keep the upstreams from seeing one request
# per visitor.
MARKET_TTL_MS=30000
HOLDERS_TTL_MS=120000
REWARDS_TTL_MS=60000
FEED_TTL_MS=30000

# ── Security ─────────────────────────────────────────────────────────────────
# Protects the bot's operator endpoints (/status, /run, /pause, /resume).
# Blank leaves them open — acceptable only because they bind to localhost.
# Set a long random string in production: openssl rand -hex 32
API_KEY=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins that may call the API. Must
# include the scheme. Use "*" to allow any origin (not recommended).
# Non-browser calls (curl, uptime checks) always pass.
CORS_ORIGINS=https://spaceinu.art,https://www.spaceinu.art
